# Anthropic API key — REQUIRED.
# Get it at https://console.anthropic.com/settings/keys
# It must start with "sk-ant-". Paste the FULL key on one line, no quotes, no spaces.
# Edit this file with a plain-text editor (nano / VS Code) — NOT TextEdit, which
# can insert hidden characters that cause "invalid x-api-key" errors.
ANTHROPIC_API_KEY=your_key_here

# Optional — only needed for LinkedIn Easy Apply automation.
LI_EMAIL=your_linkedin_email@gmail.com
LI_PASSWORD=your_linkedin_password
